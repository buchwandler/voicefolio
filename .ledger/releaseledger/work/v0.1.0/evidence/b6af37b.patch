+# Build and publish the Voicefolio Python package when a GitHub Release is published.
+
+name: Publish Voicefolio Package
+
+on:
+  release:
+    types: [published]
+
+permissions:
+  contents: read
+
+jobs:
+  deploy:
+    runs-on: ubuntu-latest
+
+    steps:
+      - name: Check out release
+        uses: actions/checkout@v4
+
+      - name: Set up Python
+        uses: actions/setup-python@v5
+        with:
+          python-version: "3.13"
+
+      - name: Install Voicefolio build tooling
+        run: python -m pip install --upgrade pip build twine
+      - name: Build Voicefolio package
+        run: |
+          rm -rf dist
+          python -m build
+      - name: Check built distributions
+        run: python -m twine check dist/*
+      - name: Validate Voicefolio release artifacts
+        env:
+          RELEASE_TAG: ${{ github.event.release.tag_name }}
+        run: |
+          python - <<'PY'
+          import os
+          import re
+          import zipfile
+          from email import policy
+          from email.parser import Parser
+          from pathlib import Path
+
+          from packaging.requirements import Requirement
+
+          tag_version = os.environ["RELEASE_TAG"].removeprefix("v")
+          artifacts = list(Path("dist").iterdir())
+          wheels = [path for path in artifacts if path.suffix == ".whl"]
+          sdists = [path for path in artifacts if path.name.endswith(".tar.gz")]
+          assert len(wheels) == 1, wheels
+          assert len(sdists) == 1, sdists
+          wheel_match = re.fullmatch(r"voicefolio-([^-]+)-[^-]+-[^-]+-[^-]+\.whl", wheels[0].name)
+          sdist_match = re.fullmatch(r"voicefolio-([^-]+)\.tar\.gz", sdists[0].name)
+          assert wheel_match is not None, wheels[0]
+          assert sdist_match is not None, sdists[0]
+          assert wheel_match.group(1) == tag_version, (wheel_match.group(1), tag_version)
+          assert sdist_match.group(1) == tag_version, (sdist_match.group(1), tag_version)
+
+          with zipfile.ZipFile(wheels[0]) as archive:
+              metadata_name = next(name for name in archive.namelist() if name.endswith("METADATA"))
+              metadata = Parser(policy=policy.default).parsestr(
+                  archive.read(metadata_name).decode("utf-8")
+              )
+              assert metadata["Name"] == "voicefolio"
+              assert metadata["Version"] == tag_version
+              requirements = [
+                  Requirement(value) for value in metadata.get_all("Requires-Dist", [])
+              ]
+              requirement_names = {requirement.name for requirement in requirements}
+              assert "typer" in requirement_names
+              names = set(archive.namelist())
+              expected = {
+                  "voicefolio/py.typed",
+                  "voicefolio/resources/catalogs/kyutai-tts-voices.json",
+                  "voicefolio/resources/sources/kyutai-tts-voices-licenses.json",
+              }
+              assert expected <= names
+          PY
+      - name: Publish Voicefolio package to PyPI
+        uses: pypa/gh-action-pypi-publish@v1.14.1
+        with:
+          password: ${{ secrets.PYPI_API_TOKEN }}
+          attestations: false
